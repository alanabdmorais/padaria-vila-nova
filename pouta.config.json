{
  "contentTypes": [
    {
      "type": "profile",
      "label": "Perfil",
      "writePath": "content/_index.md",
      "fields": [
        { "name": "title", "label": "Nome do negócio", "type": "text" },
        { "name": "bio", "label": "Biografia / descrição curta", "type": "text" },
        { "name": "foto_perfil", "label": "Foto de perfil", "type": "image" },
        { "name": "instagram_url", "label": "URL do Instagram", "type": "text" },
        { "name": "whatsapp_url", "label": "URL do WhatsApp", "type": "text" }
      ]
    },
    {
      "type": "links",
      "label": "Links",
      "writePath": "content/links/{slug}.md",
      "fields": [
        { "name": "slug", "label": "Identificador (slug)", "type": "slug" },
        { "name": "title", "label": "Título do link", "type": "text" },
        { "name": "link_url", "label": "URL de destino", "type": "text" },
        { "name": "icone", "label": "Ícone (classe Font Awesome, opcional)", "type": "text" },
        { "name": "peso", "label": "Ordem de exibição", "type": "number" }
      ]
    }
  ]
}
